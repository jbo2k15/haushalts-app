JWT_SECRET=ersetze-mit-langem-zufaelligem-string
ADMIN_EMAIL=deine@email.de
ADMIN_PASSWORD=ErsetzeWithSicheremPasswort1!
FRONTEND_URL=https://deine-domain.de

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=deine@gmail.com
SMTP_PASS=dein-gmail-app-passwort

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:deine@gmail.com

WASTE_ICAL_URL=https://dein-abfallkalender-anbieter.de/ical/...

# Dienstplan-Kalender (optional): Dienste aus einem iCal-Abo erscheinen an
# ihrem Diensttag als Aufgaben. Der Link enthaelt meist einen geheimen
# Schluessel - nicht weitergeben.
# DUTY_ICAL_URL=https://beispiel.de/dienstplan.ics?key=...
# Nur Termine mit diesem Text uebernehmen (Abo mit mehreren Familien):
# DUTY_ICAL_FILTER=Muster
# Vorsatz im Aufgabentitel:
# DUTY_ICAL_LABEL=Hühner
# Abgehakte Dienste an die Quelle melden (POST { key, uid, erledigt }). Der
# Schluessel kommt aus DUTY_ICAL_URL (?key=...), sonst DUTY_DONE_KEY setzen:
# DUTY_DONE_URL=https://beispiel.de/api/dienst-erledigt
# DUTY_DONE_KEY=

# Wetterabhaengige Aufgaben (optional): Standort fuer den Regen-Check.
# Ohne Angabe bleibt die Automatik aus.
# WEATHER_LAT=52.52
# WEATHER_LON=13.41
# Regenmenge (mm seit Mitternacht), ab der wetterabhaengige Aufgaben
# automatisch als erledigt gelten (Default 5).
# WEATHER_RAIN_THRESHOLD_MM=5

# Fairness-Statistik (optional, Default an): "false" schaltet sie komplett ab.
# FAIRNESS_ENABLED=false

# Familien-Display (optional, Default aus): "true" schaltet /api/display frei.
# Zugriff nur mit einem Display-Schluessel aus den Einstellungen.
# DISPLAY_API_ENABLED=true

# Der Display-Zugang ist nur im Heimnetz nutzbar: Anfragen ueber Cloudflare
# (oeffentliche Adresse) werden abgewiesen. Nur setzen, wenn das Display
# bewusst ueber die oeffentliche Adresse angebunden werden soll.
# DISPLAY_API_ALLOW_PROXIED=true
